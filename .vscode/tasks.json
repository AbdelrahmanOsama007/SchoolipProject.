{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/SchoolipProject.api/SchoolipProject.api.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/SchoolipProject.api/SchoolipProject.api.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/SchoolipProject.api/SchoolipProject.api.csproj"
            ],
            "problemMatcher": "$msCompile",
            "isBackground": true,
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "docker-run",
            "command": "docker",
            "type": "process",
            "args": [
                "run",
                "--rm",
                "-p",
                "8080:8080",
                "-p",
                "8081:8081",
                "schoolipproject-api"
            ],
            "problemMatcher": [],
            "dependsOn": "docker-build"
        },
        {
            "label": "docker-build",
            "command": "docker",
            "type": "process",
            "args": [
                "build",
                "-t",
                "schoolipproject-api",
                "-f",
                "${workspaceFolder}/SchoolipProject.api/Dockerfile",
                "${workspaceFolder}"
            ],
            "problemMatcher": []
        },
        {
            "label": "clean",
            "command": "dotnet",
            "type": "process",
            "args": [
                "clean",
                "${workspaceFolder}/SchoolipProject.api/SchoolipProject.api.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "restore",
            "command": "dotnet",
            "type": "process",
            "args": [
                "restore",
                "${workspaceFolder}/SchoolipProject.api/SchoolipProject.api.csproj"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}

